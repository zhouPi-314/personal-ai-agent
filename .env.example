# 复制为 .env 后填写；.env 已在 .gitignore 中，不会入库。

PAA_ENV=dev
PAA_HOST=127.0.0.1
PAA_PORT=8000

# 例：postgresql+psycopg://<user>:<password>@127.0.0.1:5432/paa
PAA_DATABASE_URL=

# 模型供应商（deepseek / openai-compatible / ...）
PAA_MODEL_PROVIDER=
PAA_MODEL_BASE_URL=
PAA_MODEL_NAME=
PAA_MODEL_API_KEY=

# 主通道：本机 DSH 的 OpenAI 兼容端口（可选）
# 端口会随 DSH 重启变化，以 %USERPROFILE%\.dsh\our-free-model\settings.json 的 forward.port 为准
PAA_LOCAL_BASE_URL=
PAA_LOCAL_API_KEY=
PAA_LOCAL_MODEL=

# 人格卡路径，相对项目根；从 persona.example.md 复制一份改成自己的
PAA_PERSONA_PATH=persona.md

# 对话用户显示名，用于在数据库里区分身份
PAA_USER_NAME=owner

# OneBot v11 网关（可选；不填则不接 QQ）
# 常见配置：WebSocket 正向连接 3001，HTTP 接口 3000
PAA_ONEBOT_WS_URL=
PAA_ONEBOT_HTTP_URL=
PAA_ONEBOT_ACCESS_TOKEN=
PAA_ONEBOT_SELF_ID=

# 备份上传目标（user@host）；填写后 backup.ps1 -Upload 才会使用
PAA_BACKUP_REMOTE=

# 价格表路径（相对项目根）；从 pricing.example.json 复制
PAA_PRICING_PATH=pricing.json

# 每日 token 配额；0 表示不限制。超出后停止回复并提示一次
PAA_DAILY_TOKEN_QUOTA=0

# 媒体能力（默认全关；设计与安全约束见 docs/multimodal/）
PAA_MEDIA_ENABLED=false
PAA_MEDIA_STICKER_ENABLED=false
# 素材库目录（相对项目根）；必须含 index.json 才能加载，素材不进仓库
PAA_MEDIA_STICKER_DIR=data/stickers
PAA_MEDIA_STICKER_COOLDOWN_SEC=60
PAA_MEDIA_STICKER_DAILY_CAP=20
PAA_MEDIA_STICKER_RECENT=5
# 先只私聊；改成 false 才允许群聊场景发表情（群唤醒规则不变）
PAA_MEDIA_STICKER_PRIVATE_ONLY=true

# 学习线（M1.5）：只收主人私聊里的图片，先进隔离区，人工晋级后才进素材库
PAA_MEDIA_LEARN_ENABLED=false
PAA_MEDIA_QUARANTINE_DIR=data/media/quarantine
PAA_MEDIA_LEARN_DAILY_CAP=10
PAA_MEDIA_LEARN_TOTAL_CAP=200

# 图片理解（M2）：默认关；PAA_MEDIA_EGRESS_ALLOW 为空 = 任何图片都不发到云端
PAA_MEDIA_VISION_ENABLED=false
PAA_MEDIA_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
PAA_MEDIA_EGRESS_ALLOW=

# 语音识别（M3）：本地侧车，纯 CPU，不出网；需要 ffmpeg 解码 AMR
PAA_MEDIA_ASR_ENABLED=false
PAA_MEDIA_ASR_PYTHON=runtime/python312/python.exe
PAA_MEDIA_ASR_MODEL_DIR=models/sensevoice
PAA_MEDIA_ASR_WORKER=scripts/asr_worker.py
PAA_MEDIA_FFMPEG=runtime/ffmpeg/bin/ffmpeg.exe

# 语音合成（M3）：off / voice_input（收到语音才用语音回）/ always
PAA_MEDIA_TTS_ENABLED=false
PAA_MEDIA_TTS_MODE=voice_input
PAA_MEDIA_TTS_VOICE=Microsoft Huihui Desktop
PAA_MEDIA_TTS_MAX_CHARS=150
